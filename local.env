APP_NAME=CS Fundamentals API
ENV=dev
PORT=8080
LOG_LEVEL=INFO
WEB_CONCURRENCY=4
GRACEFUL_TIMEOUT=10          # How long Uvicorn waits in seconds for in-flight requests to finish after receiving SIGTERM
TEST_TIMEOUT_SECONDS=30      # caps pytest run in the runner subprocess
# DB_URL=postgresql+psycopg://usr:pwd@localhost:5432/cs_fundamentals
