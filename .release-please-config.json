{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",

  "release-type": "python",

  "packages": {
    ".": {
      "package-name": "cs-fundamentals",
      "release-type": "python",

      "changelog-path": "CHANGELOG.md",

      "include-component-in-tag": false,

      "extra-files": [
        {
          "type": "yaml",
          "path": "helm/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "helm/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ],
      "extra-file-updaters": [
        {
          "file": "helm/values.yaml",
          "type": "regex",
          "pattern": "tag:\\s*\"(?<version>[^\"]+)\"\\s*#\\s*x-release-please-version",
          "replacement": "tag: \"${version}\"  # x-release-please-version"
        }
      ]
    }
  }
}
